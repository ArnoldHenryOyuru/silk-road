# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_SITE_URL=""

# Supabase (leave blank to run in Offline Demo Mode with seeded campus data)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Payment Provider ("pesapal" or "nylon", defaults to "pesapal")
NEXT_PUBLIC_PAYMENT_PROVIDER="pesapal"

# Pesapal (leave blank to use simulated sandbox checkout)
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_BASE_URL="https://cybqa.pesapal.com/pesapalv3"
PESAPAL_IPN_ID=""

# Nylon Pay (leave blank to use simulated sandbox checkout)
NYLONPAY_API_KEY=""
NYLONPAY_API_SECRET=""
NYLONPAY_WEBHOOK_SECRET=""
NYLONPAY_TEST_OUTCOME="success"
NYLONPAY_ALLOW_SANDBOX="true"

# Resend Email & Deletion Logging
RESEND_API_KEY=""
DELETION_EMAIL_FROM=""
DELETION_LOG_SECRET=""

# Admin Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
ADMIN_PUSH_WEBHOOK_SECRET=""

# Cloudflare Turnstile CAPTCHA on Sign-Up (optional; uses signed fallback when unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Lifecycle Cron Secret (protects /api/cron/lifecycle for 24h draft reminders & 14d recovery expiration)
CRON_SECRET=""

